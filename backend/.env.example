# VGAS Shopping AI Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
APP_NAME=VGAS Shopping AI
APP_VERSION=2.5.0
DEBUG=True
PORT=8000

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=vgas_shopping
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Affiliate IDs
AMAZON_AFFILIATE_ID=vgas-vikasg-21
FLIPKART_AFFILIATE_ID=your_flipkart_id
EARNKARO_API_KEY=your_earnkaro_key

# WhatsApp Bot Configuration
WHATSAPP_BOT_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER=919881300933

# PayPal Configuration
PAYPAL_BUSINESS_EMAIL=gunjalvikas786@gmail.com
PAYPAL_API_CLIENT_ID=your_paypal_client_id
PAYPAL_API_SECRET=your_paypal_secret

# Currency API
CURRENCY_API_KEY=your_currency_api_key
EXCHANGE_RATE_API=https://api.exchangerate-api.com/v4/latest/USD

# Scraper Settings
MAX_CONCURRENT_SCRAPERS=10
SCRAPER_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) VGAS-Shopping-AI/2.5.0

# Security
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://vgas-app.com"
